{# JeeSite5 Beetl 列表页面模板：DataGrid 数据表格 + 查询表单 #}
#save("/views/modules/{{ tableInfo.modulePath }}", "List.html")

<% layout('/layouts/default.html', {title: '{{ tableInfo.comment }}管理', libs: ['dataGrid']}){ %>
<div class="main-content">
	<div class="box box-main">
		<div class="box-header">
			<div class="box-title">
				<i class="fa icon-notebook"></i> ${text('{{ tableInfo.comment }}管理')}
			</div>
			<div class="box-tools pull-right">
				<a href="#" class="btn btn-default" id="btnSearch" title="${text('查询')}"><i class="fa fa-filter"></i> ${text('查询')}</a>
				<% if(hasPermi('{{ tableInfo.modulePath }}:{{ tableInfo.nameLowerFirst }}:edit')){ %>
					<a href="${ctx}/{{ tableInfo.modulePath }}/{{ tableInfo.nameLowerFirst }}/form" class="btn btn-primary btnTool" title="${text('新增{{ tableInfo.comment }}')}"><i class="fa fa-plus"></i> ${text('新增')}</a>
				<% } %>
				<a href="#" class="btn-setting" id="btnSetting" title="${text('设置')}"><i class="fa icon-settings"></i></a>
			</div>
		</div>
		<div class="box-body">
			<#form:form id="searchForm" model="${{{ tableInfo.nameLowerFirst }}}" action="${ctx}/{{ tableInfo.modulePath }}/{{ tableInfo.nameLowerFirst }}/listData" method="post" class="form-inline "
					data-page-no="${parameter.pageNo}" data-page-size="${parameter.pageSize}" data-order-by="${parameter.orderBy}">
{% for column in tableInfo.otherColumn %}
{% if loop.index < 4 %}
				<div class="form-group">
					<label class="control-label">${text('{{ column.comment }}')}：</label>
					<div class="control-inline">
{% if column.type == "java.util.Date" %}
						<#form:input path="{{ column.name }}_gte" readonly="true" maxlength="20" class="form-control laydate width-date"
							dataFormat="date" data-type="date" data-format="yyyy-MM-dd" data-done="{{ column.name }}_lte.click()"/>
						&nbsp;-&nbsp;
						<#form:input path="{{ column.name }}_lte" readonly="true" maxlength="20" class="form-control laydate width-date"
							dataFormat="date" data-type="date" data-format="yyyy-MM-dd"/>
{% elif column.type == "java.lang.String" %}
						<#form:input path="{{ column.name }}" maxlength="{{ column.maxLength or 200 }}" class="form-control width-120"/>
{% else %}
						<#form:input path="{{ column.name }}" class="form-control width-120"/>
{% endif %}
					</div>
				</div>
{% endif %}
{% endfor %}
				<div class="form-group">
					<label class="control-label">${text('数据状态')}：</label>
					<div class="control-inline width-120">
						<#form:select path="status" dictType="sys_search_status" blankOption="true" class="form-control isQuick"/>
					</div>
				</div>
				<div class="form-group">
					<button type="submit" class="btn btn-primary btn-sm"><i class="glyphicon glyphicon-search"></i> ${text('查询')}</button>
					<button type="reset" class="btn btn-default btn-sm isQuick"><i class="glyphicon glyphicon-repeat"></i> ${text('重置')}</button>
					<button type="button" class="btn btn-link btn-sm btnFormMore"><i class="fa fa-angle-double-down"></i></button>
				</div>
				<div class="form-more">
{% for column in tableInfo.otherColumn %}
{% if loop.index >= 4 %}
					<div class="form-group">
						<label class="control-label">${text('{{ column.comment }}')}：</label>
						<div class="control-inline">
{% if column.type == "java.util.Date" %}
							<#form:input path="{{ column.name }}_gte" readonly="true" maxlength="20" class="form-control laydate width-datetime"
								dataFormat="datetime" data-type="datetime" data-format="yyyy-MM-dd HH:mm" data-done="{{ column.name }}_lte.click()"/>
							&nbsp;-&nbsp;
							<#form:input path="{{ column.name }}_lte" readonly="true" maxlength="20" class="form-control laydate width-datetime"
								dataFormat="datetime" data-type="datetime" data-format="yyyy-MM-dd HH:mm"/>
{% else %}
							<#form:input path="{{ column.name }}" maxlength="{{ column.maxLength or 200 }}" class="form-control width-120"/>
{% endif %}
						</div>
					</div>
{% endif %}
{% endfor %}
				</div>
			</#form:form>
			<table id="dataGrid"></table>
			<div id="dataGridPage"></div>
		</div>
	</div>
</div>
<% } %>
<script>
$('#dataGrid').dataGrid({
	searchForm: $('#searchForm'),
	columnModel: [
{% if tableInfo.pkColumn | length > 0 %}{% set pk = tableInfo.pkColumn[0] %}{% endif %}
{% for column in tableInfo.fullColumn %}
{% if not column.isPK and loop.first %}
		{header:'${text("{{ column.comment }}")}', name:'{{ column.name }}', index:'a.{{ column.obj.name }}', width:250, align:"left", frozen:true, formatter: function(val, obj, row, act){
			return '<a href="${ctx}/{{ tableInfo.modulePath }}/{{ tableInfo.nameLowerFirst }}/form?{{ pk.name }}='+row.{{ pk.name }}+'" class="btnList" data-title="${text("编辑{{ tableInfo.comment }}")}">'+$.jgrid.htmlEncode(val||row.{{ pk.name }})+'</a>';
		}},
{% elif not column.isPK %}
		{header:'${text("{{ column.comment }}")}', name:'{{ column.name }}', index:'a.{{ column.obj.name }}', width:150, align:"{% if column.type == 'java.util.Date' %}center{% else %}left{% endif %}"},
{% endif %}
{% endfor %}
		{header:'${text("状态")}', name:'status', index:'a.status', width:150, align:"center", formatter: function(val, obj, row, act){
			return js.getDictLabel("#{@DictUtils.getDictListJson('sys_search_status')}", val, '${text("未知")}', true);
		}},
		{header:'${text("创建时间")}', name:'createDate', index:'a.create_date', firstsortorder:'desc', width:150, align:"center"},
		{header:'${text("备注")}', name:'remarks', index:'a.remarks', width:150, align:"left"},
		{header:'${text("操作")}', name:'actions', width:180, formatter: function(val, obj, row, act){
			var actions = [];
			<% if(hasPermi('{{ tableInfo.modulePath }}:{{ tableInfo.nameLowerFirst }}:edit')){ %>
				actions.push('<a href="${ctx}/{{ tableInfo.modulePath }}/{{ tableInfo.nameLowerFirst }}/form?{{ pk.name }}='+row.{{ pk.name }}+'" class="btnList" title="${text("编辑{{ tableInfo.comment }}")}"><i class="fa icon-note"></i></a>&nbsp;');
				if (row.status == Global.STATUS_NORMAL){
					actions.push('<a href="${ctx}/{{ tableInfo.modulePath }}/{{ tableInfo.nameLowerFirst }}/disable?{{ pk.name }}='+row.{{ pk.name }}+'" class="btnList" title="${text("停用{{ tableInfo.comment }}")}" data-confirm="${text("确认要停用该数据吗？")}"><i class="fa icon-ban"></i></a>&nbsp;');
				} else if (row.status == Global.STATUS_DISABLE){
					actions.push('<a href="${ctx}/{{ tableInfo.modulePath }}/{{ tableInfo.nameLowerFirst }}/enable?{{ pk.name }}='+row.{{ pk.name }}+'" class="btnList" title="${text("启用{{ tableInfo.comment }}")}" data-confirm="${text("确认要启用该数据吗？")}"><i class="fa icon-check"></i></a>&nbsp;');
				}
				actions.push('<a href="${ctx}/{{ tableInfo.modulePath }}/{{ tableInfo.nameLowerFirst }}/delete?{{ pk.name }}='+row.{{ pk.name }}+'" class="btnList" title="${text("删除{{ tableInfo.comment }}")}" data-confirm="${text("确认要删除该数据吗？")}"><i class="fa fa-trash-o"></i></a>&nbsp;');
			<% } %>
			return actions.join('');
		}}
	],
	multiSort: true,
	emptyDataHint: true,
	ajaxSuccess: function(data){}
});
</script>
