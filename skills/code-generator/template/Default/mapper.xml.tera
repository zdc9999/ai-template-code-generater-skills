{# 设置保存名称与保存位置 #}
$!callback.setFileName($tool.append($tableInfo.name, "Dao.xml"))
$!callback.setSavePath($tool.append($modulePath, "/src/main/resources/mapper"))

{# 拿到主键 #}
{% if tableInfo.pkColumn | length > 0 %}
    {% set pk = tableInfo.pkColumn[0] %}
{% endif %}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="{{ tableInfo.savePackageName }}.dao.{{ tableInfo.name }}Dao">

    <resultMap type="{{ tableInfo.savePackageName }}.entity.{{ tableInfo.name }}" id="{{ tableInfo.name }}Map">
{% for column in tableInfo.fullColumn %}
        <result property="{{ column.name }}" column="{{ column.obj.name }}" jdbcType="{{ column.ext.jdbcType }}"/>
{% endfor %}
    </resultMap>

    <!--查询单个-->
    <select id="queryById" resultMap="{{ tableInfo.name }}Map">
        select
          #allSqlColumn()

        from {{ tableInfo.obj.name }}
        where {{ pk.obj.name }} = #{{ pk.name }}
    </select>

    <!--查询指定行数据-->
    <select id="queryAllByLimit" resultMap="{{ tableInfo.name }}Map">
        select
          #allSqlColumn()

        from {{ tableInfo.obj.name }}
        <where>
{% for column in tableInfo.fullColumn %}
            <if test="{{ column.name }} != null{% if column.type == "java.lang.String" %} and {{ column.name }} != ''{% endif %}">
                and {{ column.obj.name }} = #{{ column.name }}
            </if>
{% endfor %}
        </where>
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <!--统计总行数-->
    <select id="count" resultType="java.lang.Long">
        select count(1)
        from {{ tableInfo.obj.name }}
        <where>
{% for column in tableInfo.fullColumn %}
            <if test="{{ column.name }} != null{% if column.type == "java.lang.String" %} and {{ column.name }} != ''{% endif %}">
                and {{ column.obj.name }} = #{{ column.name }}
            </if>
{% endfor %}
        </where>
    </select>

    <!--新增所有列-->
    <insert id="insert" keyProperty="{{ pk.name }}" useGeneratedKeys="true">
        insert into {{ tableInfo.obj.name }}({% for column in tableInfo.otherColumn %}{{ column.obj.name }}{% if not loop.last %}, {% endif %}{% endfor %})
        values ({% for column in tableInfo.otherColumn %}#{{ column.name }}{% if not loop.last %}, {% endif %}{% endfor %})
    </insert>

    <insert id="insertBatch" keyProperty="{{ pk.name }}" useGeneratedKeys="true">
        insert into {{ tableInfo.obj.name }}({% for column in tableInfo.otherColumn %}{{ column.obj.name }}{% if not loop.last %}, {% endif %}{% endfor %})
        values
        <foreach collection="entities" item="entity" separator=",">
        ({% for column in tableInfo.otherColumn %}#{entity.{{ column.name }}}{% if not loop.last %}, {% endif %}{% endfor %})
        </foreach>
    </insert>

    <insert id="insertOrUpdateBatch" keyProperty="{{ pk.name }}" useGeneratedKeys="true">
        insert into {{ tableInfo.obj.name }}({% for column in tableInfo.otherColumn %}{{ column.obj.name }}{% if not loop.last %}, {% endif %}{% endfor %})
        values
        <foreach collection="entities" item="entity" separator=",">
            ({% for column in tableInfo.otherColumn %}#{entity.{{ column.name }}}{% if not loop.last %}, {% endif %}{% endfor %})
        </foreach>
        on duplicate key update
        {% for column in tableInfo.otherColumn %}{{ column.obj.name }} = values({{ column.obj.name }}){% if not loop.last %},
        {% endif %}{% endfor %}

    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        update {{ tableInfo.obj.name }}
        <set>
{% for column in tableInfo.otherColumn %}
            <if test="{{ column.name }} != null{% if column.type == "java.lang.String" %} and {{ column.name }} != ''{% endif %}">
                {{ column.obj.name }} = #{{ column.name }},
            </if>
{% endfor %}
        </set>
        where {{ pk.obj.name }} = #{{ pk.name }}
    </update>

    <!--通过主键删除-->
    <delete id="deleteById">
        delete from {{ tableInfo.obj.name }} where {{ pk.obj.name }} = #{{ pk.name }}
    </delete>

</mapper>